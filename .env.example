# Copy this file to .env.local and fill in the values to run the app on your computer.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# Postgres connection string (Vercel's Neon integration sets this for you)
DATABASE_URL=

# Your Anthropic API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# The password for the /admin pages
ADMIN_PASSWORD=
